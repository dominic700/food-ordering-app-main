PORT=5000
NODE_ENV=production
# EasyPanel: use the INTERNAL connection string of your Postgres service
DATABASE_URL=postgres://user:password@food-db:5432/dbname
# false for EasyPanel's Postgres, true for Render / Supabase / Neon
DB_SSL=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
TELEGRAM_BOT_TOKEN=your-bot-token
# Your frontend address, no trailing slash
FRONTEND_URL=https://your-frontend.example.com
WEB_APP_URL=https://your-frontend.example.com
